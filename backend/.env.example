# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (see README for setup steps)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/safetour?retryWrites=true&w=majority

# Long random string used to sign JWTs
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# Secret code required to register as a Police/Admin user (demo only)
ADMIN_REGISTRATION_CODE=POLICE-DEMO-2026

# Anomaly detection thresholds
STOP_MINUTES_THRESHOLD=20
DEVIATION_KM_THRESHOLD=5
